{
  "allowNonWorkspaceAccess": true,
  "altScreenMode": "always",
  "editor": "vim",
  "enableTerminalSandbox": true,
  "model": "Gemini 3.8 Flash (High)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(ls)",
      "command(grep)",
      "command(find)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(sed)",
      "command(awk)",
      "command(sort)",
      "command(uniq)",
      "command(wc)",
      "command(xargs)",
      "command(tr)",
      "command(cut)",
      "command(diff)",
      "command(rg)",
      "command(fd)",
      "command(bat)",
      "command(eza)",
      "command(jq)",
      "command(yq)",
      "command(less)",
      "command(more)",
      "command(file)",
      "command(stat)",
      "command(git)",
      "command(gh)",
      "command(go)",
      "command(cargo)",
      "command(rustc)",
      "command(python)",
      "command(python3)",
      "command(node)",
      "command(npm)",
      "command(pnpm)",
      "command(yarn)",
      "command(bun)",
      "command(pytest)",
      "command(tox)",
      "command(make)",
      "command(just)",
      "command(task)",
      "command(docker)",
      "command(podman)",
      "command(kubectl)",
      "command(helm)",
      "command(terraform)",
      "command(tofu)",
      "command(terragrunt)",
      "command(stow)",
      "command(tar)",
      "command(zip)",
      "command(unzip)",
      "command(curl)",
      "command(GOCACHE)",
      "command(wget)",
      "command(mv)",
      "command(cp)",
      "command(mkdir)",
      "command(touch)",
      "command(rm)",
      "command(chmod)",
      "command(chown)",
      "command(ln)",
      "command(tee)",
      "command(timeout)",
      "command(nohup)",
      "command(env)",
      "read_file(*)",
      "write_file(*)",
      "read_url(*)",
      "unsandboxed(docker)",
      "unsandboxed(podman)",
      "unsandboxed(kubectl)",
      "unsandboxed(helm)",
      "unsandboxed(git)",
      "unsandboxed(go)",
      "unsandboxed(npm)",
      "unsandboxed(cargo)",
      "unsandboxed(pytest)",
      "unsandboxed(curl)",
      "unsandboxed(wget)",
      "unsandboxed(stow)"
    ],
    "deny": [
      "command(rm -rf)",
      "command(rm -r)",
      "command(sudo)",
      "command(regex:curl .* \\| sh)",
      "command(regex:wget .* \\| sh)",
      "write_file(.git/)",
      "write_file(/home/user/.ssh/)",
      "read_file(/home/user/.ssh/)"
    ],
    "ask": []
  },
  "runningLightSpeed": "fast",
  "showFeedbackSurvey": false,
  "trustedWorkspaces": [
    "/Users/"
  ]
}
