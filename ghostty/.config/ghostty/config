#====================================================================
# Ghostty
#====================================================================

# --- Terminal (Compatibility First) ---
term = xterm-256color

# --- Font ---
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 16
font-thicken = true

# --- Theme (1.2+ format requires quotes for spaces) ---
theme = "Catppuccin Mocha"
minimum-contrast = 1.1

# --- Window ---
macos-titlebar-style = transparent
macos-window-buttons = visible
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
background-opacity = 0.8
background-blur = 20

# --- Custom Shader ---
custom-shader = ~/.config/ghostty/shaders/starry-sky.glsl
custom-shader-animation = true
window-colorspace = display-p3
resize-overlay = never
confirm-close-surface = true
window-save-state = never

# --- Cursor ---
cursor-style = block
cursor-style-blink = false
cursor-color = #f38ba8
cursor-click-to-move = true

# --- Scrollback (balanced memory vs usability) ---
scrollback-limit-lines = 100000
scrollback-limit-bytes = 50000000

# --- Mouse ---
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
right-click-action = copy-or-paste
copy-on-select = clipboard

# --- Clipboard Security ---
clipboard-read = allow
clipboard-paste-protection = false
clipboard-trim-trailing-spaces = true

# --- Shell Integration (SAFE MODE) ---
shell-integration = detect
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo,path

# --- Notifications (1.3 stable) ---
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# --- macOS Automation (NEW in 1.3) ---
macos-applescript = false
macos-option-as-alt = true

# --- Keybinds ---
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard
keybind = ctrl+b=text:\x02

# Optional navigation (recommended)
keybind = ctrl+shift+k=clear_screen
keybind = ctrl+shift+l=reload_config
keybind = ctrl+shift+enter=new_window

# Scrollback access while apps capture the mouse
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
keybind = ctrl+shift+m=toggle_mouse_reporting

# --- Debug (optional) ---
# enable temporarily when troubleshooting
# log-level = debug
