{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 6000
    },
    "buffer": 12000
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 20000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".terraform/**",
      ".terragrunt-cache/**",
      ".venv/**",
      "__pycache__/**",
      ".mypy_cache/**",
      ".pytest_cache/**",
      ".ruff_cache/**",
      ".next/**",
      ".nuxt/**",
      ".turbo/**",
      ".cache/**",
      "coverage/**",
      "dist/**",
      "build/**",
      "target/**",
      "node_modules/**",
      "vendor/**",
      "*.log",
      "*.tfstate",
      "*.tfstate.*",
      "*.plan",
      ".DS_Store",
      ".idea/**",
      ".vscode/**",
      "*.lock",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "Cargo.lock",
      "go.sum",
      "*.sqlite",
      "*.db",
      "*.min.js",
      "*.min.css",
      "*.map"
    ]
  },
  "lsp": {
    "terraform": {
      "command": [
        "terraform-ls",
        "serve"
      ],
      "extensions": [
        ".tf",
        ".tfvars"
      ]
    }
  },
  "update": "notify",
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1600,
      "max_height": 1600,
      "max_base64_bytes": 3000000
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.tfstate",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.tfstate.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*id_rsa*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*id_ed25519*",
      "effect": "deny"
    },
    {
      "action": "read",
